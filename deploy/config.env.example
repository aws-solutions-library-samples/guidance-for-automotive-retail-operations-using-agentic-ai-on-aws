# deploy/config.env.example — optional settings for the deployment scripts.
#
# Copy to deploy/config.env (git-ignored) and `source deploy/config.env` before
# running deploy/bootstrap.sh or deploy/deploy.sh. The seed-user password is
# required for an applied deployment; all other settings have safe defaults.

# --- target -----------------------------------------------------------------
export AWS_REGION=us-east-1            # the only region the deployers are tested in
# export AWS_PROFILE=my-dev-account    # use a named CLI profile
# Environment name (default dev): every resource is named retail-ops-<env>-…,
# so environments share an account without sharing a resource. 2-8 lowercase
# letters and digits, without "aws", "amazon" or "cognito" (app/infra/naming.py).
# The scripts also take --env <name>.
# export RETAIL_OPS_ENV=dev

# --- sign-in ----------------------------------------------------------------
# Required with --apply. Use a unique development-only password that satisfies
# the Cognito policy; keep the value only in git-ignored deploy/config.env.
export RETAIL_OPS_SEED_PASSWORD=

# Provision the Hosted-UI/SSO surface on the Cognito pool (default on). The SSO
# button appears in the console only once an external identity provider exists.
export RETAIL_OPS_ENABLE_SSO=1
# OIDC provider (e.g. an enterprise directory): either a Secrets Manager id ...
# export RETAIL_OPS_IDP_SECRET=retail-ops-dev-federate-oidc
# ... or the client credentials directly
# export RETAIL_OPS_IDP_CLIENT_ID=
# export RETAIL_OPS_IDP_CLIENT_SECRET=
# export RETAIL_OPS_IDP_NAME=CorpDirectory
# export RETAIL_OPS_IDP_PROTOCOL=oidc          # oidc | saml
# export RETAIL_OPS_IDP_METADATA_URL=          # SAML metadata URL (when protocol=saml)
#
# SSO allowlist: the the enterprise IdP aliases that get the Administrator
# role (every staff module, every market, district and dealer). Any other SSO
# sign-in is refused. Comma-separated; case and an optional RETAIL_OPS_IDP_ALIAS_DOMAIN suffix are
# ignored. Applied by the deploy stage `sso-admins` (re-run it alone with
# `deploy/deploy.sh --apply --only sso-admins`). Unset = no change; set to an
# empty value to remove every allowlisted Administrator.
# export RETAIL_OPS_SSO_ADMINS=alias1,alias2

# --- AWS Quick -----------------------------------------------------------
# The l4 stage sets ENABLE_QUICK=true on the service Lambda when the account has
# an AWS Quick subscription (false when it has none), which turns on the
# console's Quick panels and GET /oem/quick/* (read calls only: list Flows and
# dashboards, embed URL for the shared embed user). Uncomment to force it.
# export ENABLE_QUICK=false                   # true | false
# Per-user embedding (RETAIL_OPS_QUICK_PER_USER_EMBED=1) is NOT set by any stage:
# it registers every console user who opens a dashboard as a Quick reader, which
# can add per-user subscription cost. See docs/QUICK_BUILD.md before turning it on.
# The l4 stage also sets RETAIL_OPS_QUICK_EMBED_DOMAINS to the console URL from
# app/infra/console-config.json; embed URLs allow exactly these origins
# (AllowedDomains, up to three https origins). Uncomment to choose them yourself.
# export RETAIL_OPS_QUICK_EMBED_DOMAINS=https://console.example.com

# --- API CORS -----------------------------------------------------------------
# The l4 stage sets RETAIL_OPS_CONSOLE_ORIGIN on the service Lambda to the same
# console URL: the only origin the API answers CORS for (never `*`; the API
# carries a bearer token). The local console (http://localhost:3100) is always
# allowed as well. Uncomment to name the origin(s) yourself (comma-separated).
# export RETAIL_OPS_CONSOLE_ORIGIN=https://console.example.com

# --- development token ----------------------------------------------------------
# The authorizer accepts plain development tokens (user:<id>) until you switch
# them off; verify.sh needs them. After verifying a shared environment:
#   python3 -m app.infra.deploy_l4 --dev-token off --apply
# (later l4 deploys keep the setting; --dev-token on accepts them again).

# --- edge protection --------------------------------------------------------
# Restrict the console to corporate ranges (comma-separated CIDRs). Off by
# default: an allowlist blocks everyone else, including you if you get it wrong.
# export RETAIL_OPS_WAF_ALLOW_CIDRS=203.0.113.0/24
# export RETAIL_OPS_WAF_RATE_LIMIT=2000        # requests per 5 minutes per IP

# --- models (defaults are Claude inference profiles available in us-east-1) --
# export RETAIL_OPS_BEDROCK_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0     # phrasing
# export RETAIL_OPS_A3_AGENT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0  # agent loop

# --- outreach ---------------------------------------------------------------
# The sender of customer emails (nurture, service follow-up, the Sales Agent's
# send_outreach): an SES identity verified in this account and region. There is
# no default. Unset, every email send is recorded as undeliverable on the
# message and falls back to a dealer task (SMS through SNS is unaffected). The
# l4, l6, streaming and agentcore stages copy it onto the Lambdas and runtimes.
# export RETAIL_OPS_SES_FROM=no-reply@example.com

# --- agentic jobs -----------------------------------------------------------
# Every scheduled job the agent bar shows ships ENABLED, for both markets (they
# run at autonomy level `recommend`: cards, leads and drafts, never customer
# messages; store-digest writes cockpit insights with Bedrock). --enable-jobs
# also enables autonomy-promotion.
# export RETAIL_OPS_STALL_SLA_DAYS=7           # stall sweep threshold (days idle)
# export RETAIL_OPS_DUE_SERVICE_DAYS=14        # due-service reminder horizon
