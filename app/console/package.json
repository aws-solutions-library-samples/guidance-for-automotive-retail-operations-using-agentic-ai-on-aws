{
  "name": "retail-ops-console",
  "version": "0.1.0",
  "private": true,
  "description": "Retail Ops operator console (Next.js App Router). Migration reference: ports the Journeys Kanban from app/web/journeys.html onto the same API.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "node scripts/check-literals.mjs && next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "lint:units": "node scripts/check-literals.mjs && node scripts/check-agent-catalog.mjs && node scripts/check-screen-links.mjs",
    "lint:agents": "node scripts/check-agent-catalog.mjs",
    "lint:links": "node scripts/check-screen-links.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-transcribe-streaming": "^3.1146.0",
    "@aws-sdk/credential-provider-cognito-identity": "^3.972.71",
    "next": "16.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "5.5.3"
  }
}
