    ],
    "Sid": "RetailOpsDynamo"
   },
   {
    "Action": [
     "s3:GetObject"
    ],
    "Effect": "Allow",
    "Resource": [
     "arn:aws:s3:::bedrock-agentcore-retail-ops-123456789012/*"
    ],
    "Sid": "RetailOpsCode"
   },
   {
    "Action": [
     "events:PutEvents"
    ],
    "Effect": "Allow",
    "Resource": [
     "arn:aws:events:us-east-1:123456789012:event-bus/app-bus-dev"
    ],
    "Sid": "RetailOpsEvents"
   },
   {
    "Action": [
     "ses:SendEmail",
     "ses:SendRawEmail",
     "sns:Publish"
    ],
    "Effect": "Allow",
    "Resource": "*",
    "Sid": "Outreach"
   },
   {
    "Action": [
     "bedrock-agentcore:InvokeAgentRuntime"
    ],
    "Effect": "Allow",
    "Resource": [
     "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/retail_ops_dev_*"
    ],
    "Sid": "AgentRuntime"
   }
  ],
  "Version": "2012-10-17"
